{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shikra Console",
  "version": "0.1.1",
  "identifier": "dev.shikra.console",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Shikra Console",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
